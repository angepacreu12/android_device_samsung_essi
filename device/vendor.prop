# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
audio.offload.min.duration.secs=30
ro.audio.spatializer_enabled=true

# Display
debug.sf.enable_adpf_cpu_hint=true
debug.sf.show_refresh_rate_overlay_render_rate=true
persist.sys.sf.color_saturation=1.0
ro.hardware.egl=samsung
ro.hardware.vulkan=samsung
ro.opengles.version=196610
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.has_HDR_display=1
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.protected_contents=1
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.set_display_power_timer_ms=200
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=300
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true

# DRM
drm.service.enabled=true

# Media
debug.stagefright.c2-poolmask=1507328
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec_delayed_params=1
debug.stagefright.ccodec_lax_type=true
debug.stagefright.ccodec_strict_type=true
media.c2.dmabuf.padding=512
media.c2.hal.selection=aidl

# Fingerprint, read by the Lineage HAL (device.mk Fingerprint; hardware/samsung bb6e7b20 aidl/fingerprint/fingerprint.sysprop).
# type and request_touch_event as LineageOS sm7125-common b315034e vendor.prop:160-161 (optical UDFPS, Samsung libsfp):
# the HAL then sends SEM_REQUEST_TOUCH_EVENT (22) with 2 on finger down, 1 on finger up (Session.cpp:198-216).
# sensor_location = x|y|radius in px, the stock-derived values of the framework overlay (docs/FINGERPRINT_1001.md §7).
ro.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.sensor_location=540|2039|113
ro.vendor.fingerprint.request_touch_event=true

# Radio
ro.radio.noril=no
ro.telephony.default_cdma_sub=0
ro.telephony.default_network=24,24

# Wi-Fi
wifi.aware.interface=wifi-aware0

# Miscellaneous
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapmaxfree=32m
dalvik.vm.heapminfree=8m
dalvik.vm.heapsize=512m
dalvik.vm.heapstartsize=16m
dalvik.vm.heaptargetutilization=0.5
debug.c2.use_dmabufheaps=1
debug.hwc.winupdate=1
debug.hwui.use_hint_manager=true
dev.usbsetting.embedded=on
external_storage.casefold.enabled=1
external_storage.projid.enabled=1
external_storage.sdcardfs.enabled=0
graphics.gpu.profiler.support=true
log.tag.stats_log=I
persist.sys.dalvik.vm.lib.2=libart.so
persist.vendor.config.dm.autostart=0
persist.vendor.sys.dm.zip=0
persist.vendor.wlbtlog.maxfiles=5
persist.vendor.wlbtlog.maxfilesize=50
ro.apk_verity.mode=2
