<compatibility-matrix version="1.0" type="framework">
    <!-- Audio -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.audio</name>
        <version>1</version>
        <interface>
            <name>ISecAudioHal</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Authentication Framework -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.authfw</name>
        <version>1</version>
        <interface>
            <name>ISehAuthenticationFramework</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Bluetooth -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.bluetooth</name>
        <version>1</version>
        <interface>
            <name>ISehBluetooth</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Bluetooth Audio -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.bluetooth.audio</name>
        <version>2</version>
        <interface>
            <name>ISehBluetoothAudioProviderFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- GNSS (GPS) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.gnss</name>
        <version>1</version>
        <interface>
            <name>ISehGnss</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- HyPer (Performance) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.hyper</name>
        <version>2</version>
        <interface>
            <name>ISehHyPer</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- KeyMint (Keystore/Security) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.keymint</name>
        <version>3</version>
        <interface>
            <name>ISehKeyMintExtension</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>ISehKeyMintFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- KHDM (Knox Hardware Data Manager) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.khdm</name>
        <version>1</version>
        <interface>
            <name>ISehKhdm</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- MPP Store (Media) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.media.mpp</name>
        <version>5</version>
        <interface>
            <name>ISehMppStore</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- MPOS (Mobile Point of Sale) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.mpos</name>
        <version>1</version>
        <interface>
            <name>ISehMpos</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- NFC -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.nfc_aidl</name>
        <version>1</version>
        <interface>
            <name>ISehNfc</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Radio Bridge (Dual SIM) -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.radio.bridge</name>
        <version>1</version>
        <interface>
            <name>ISehRadioBridge</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>

    <!-- Radio Channel -->
    <hal format="aidl" optional="true">
        <name>vendor.samsung.hardware.radio.channel</name>
        <version>1</version>
        <interface>
            <name>ISehRadioChannel</name>
            <instance>epdgd</instance>
        </interface>
    </hal>
</compatibility-matrix>
