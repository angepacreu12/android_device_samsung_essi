# Samsung boot control HAL for recovery. Ramdisk files are labelled rootfs and
# slotinfo is a generic block_device here, so run it in the permissive recovery domain.
service vendor.boot-default /system/bin/hw/android.hardware.boot-service.exynos_recovery
    class early_hal
    user root
    group root
    seclabel u:r:recovery:s0
    interface aidl android.hardware.boot.IBootControl/default
